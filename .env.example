# Copy to .env and fill in ONE of the two options below.

# Option A: call Anthropic's API directly (simplest for local dev/demo).
ANTHROPIC_API_KEY=

# Option B: use Amazon Bedrock instead (leave ANTHROPIC_API_KEY blank).
# Configure AWS credentials normally (env vars, ~/.aws/credentials, or an
# assumed role) and BidWright will pick Bedrock automatically. AgentCore
# deployments always use this path.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2

# Optional overrides:
# BIDWRIGHT_MODEL_PROVIDER=anthropic   # or "bedrock" — force a provider
# BIDWRIGHT_MODEL_ID=claude-sonnet-4-5-20250929
